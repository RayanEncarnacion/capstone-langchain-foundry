# Copy to .env and fill in. NEVER commit the real .env.

# Required for project services such as managed memory. Model traffic uses the
# APIM route below when gateway mode is enabled.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Required: model deployment name created in the Foundry project.
FOUNDRY_MODEL=gpt-4o-mini

# Required: Foundry IQ knowledge base MCP endpoint + Entra scope.
KB_MCP_URL=https://<service>.search.windows.net/knowledgebases/<knowledge-base>/mcp?api-version=<api-version>
KB_MCP_SCOPE=https://search.azure.com/.default

# Required: Azure Cosmos DB (tasks). Prefer a connection string, or set
# COSMOS_ENDPOINT for keyless (DefaultAzureCredential) access.
COSMOS_CONNECTION_STRING=AccountEndpoint=https://<account>.documents.azure.com:443/;AccountKey=<key>;
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_DATABASE=capstone-db
COSMOS_CONTAINER=tasks
# Cross-session preferences fallback container (partition key /user_id).
COSMOS_PREFERENCES_CONTAINER=preferences

# Cross-session memory: Foundry managed Memory Store (preview) is tried first,
# scoped to the authenticated user's oid; on failure it falls back to Cosmos.
MEMORY_STORE_NAME=foundry-assistant-memory-store
# Memory stores are PROJECT-scoped. Set the full project endpoint here (it
# differs from the resource-level FOUNDRY_PROJECT_ENDPOINT the chat client uses):
#   https://<resource>.services.ai.azure.com/api/projects/<project>
# Or set MEMORY_PROJECT_NAME to have it derived from FOUNDRY_PROJECT_ENDPOINT.
FOUNDRY_PROJECT_SUFFIXED_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# MEMORY_PROJECT_NAME=<project>
# Force a backend: foundry | cosmos | auto (default).
# PREFERENCE_BACKEND=auto

# Auth: real Microsoft Entra tokens. The caller sends a genuine Entra access
# token (e.g. from `az account get-access-token`); the API validates it and
# derives the user id from the `oid` claim. Both settings are OPTIONAL:
#   ENTRA_TENANT_ID     restrict accepted tokens to one tenant (else trust tid).
#   ENTRA_API_AUDIENCE  if set, the token `aud` must match it exactly.
# ENTRA_TENANT_ID=<tenant-guid>
# ENTRA_API_AUDIENCE=https://<resource>.services.ai.azure.com

# Content Safety (optional): screens inbound/outbound text. Omit to skip.
# CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# CONTENT_SAFETY_KEY=<key>

# Explicit model-context construction. Defaults shown below. Use "full" only
# in local development when exact prompt inspection is required; production
# should use "redacted" or "off" because model context may contain user data.
CONTEXT_INSPECTION_MODE=full
# CONTEXT_MAX_TOTAL_TOKENS=8000
# CONTEXT_MAX_HISTORY_TOKENS=4000
# CONTEXT_MAX_SUMMARY_TOKENS=600
# CONTEXT_MAX_RETRIEVAL_TOKENS=2000
# CONTEXT_MAX_TOOL_OUTPUT_TOKENS=1000
# CONTEXT_MAX_RETRIEVAL_CHUNKS=4
# CONTEXT_MAX_TOOL_ITEMS=20
# CONTEXT_KEEP_RECENT_TURNS=6
# AI gateway model route. If any APIM setting is present, gateway mode is
# enabled and startup fails unless URL, subscription key, and cache secret are
# all configured. Set APIM_GATEWAY_REQUIRED=true in deployed environments so a
# missing setting can never silently fall back to direct model traffic.
APIM_GATEWAY_REQUIRED=true
APIM_OPENAI_BASE_URL=https://appim-capstone.azure-api.net/foundry/openai/v1
APIM_SUBSCRIPTION_HEADER=Ocp-Apim-Subscription-Key
APIM_SUBSCRIPTION_KEY=<local-secret-never-commit>
# At least 32 random characters. Used only to HMAC identity/session data into
# x-cache-partition; raw oid and session IDs are never sent to APIM.
APIM_CACHE_PARTITION_SECRET=<generate-a-separate-random-secret-of-at-least-32-characters>

# Optional Azure Monitor export. Treat the connection string as a secret.
# APPLICATIONINSIGHTS_CONNECTION_STRING=<application-insights-connection-string>
