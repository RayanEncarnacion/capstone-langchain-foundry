# Copy to .env and fill in. NEVER commit the real .env.

# Required: Foundry project endpoint (NOT the OpenAI-compatible route).
# Copy from the Foundry portal → project overview.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Required: model deployment name created in the Foundry project.
FOUNDRY_MODEL=gpt-4o-mini

# Auth: JSON mapping bearer tokens -> user IDs. NEVER commit real keys.
API_KEYS={"sk-yourkey": "your-user-id"}
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-4o-mini