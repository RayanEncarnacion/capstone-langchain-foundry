# Copy to .env and fill in. NEVER commit the real .env.
# .env is git-ignored so no secret/credential is hard-coded.

# Required: Foundry v1 (OpenAI-compatible) endpoint. Copy it from the
# deployment page in Foundry. Must end with /openai/v1
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1

# Required: the deployment name you created in Foundry.
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional: API key. Leave BLANK to use Azure AD / DefaultAzureCredential
# (keyless, recommended). If set, key auth is used instead.
AZURE_OPENAI_API_KEY=

AZURE_STORAGE_CONNECTION_STRING=   # or AZURE_STORAGE_ACCOUNT_URL (keyless)
AZURE_STORAGE_CONTAINER=notes
AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
AZURE_SEARCH_API_KEY=              # omit for keyless (DefaultAzureCredential)
AZURE_SEARCH_INDEX=notes-index
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
COSMOS_ENDPOINT=
COSMOS_CONNECTION_STRING=
COSMOS_DATABASE=capstone-db
COSMOS_CONTAINER=tasks

# Phase 5 memory containers (auto-created on first boot):
COSMOS_CHECKPOINTS_CONTAINER=checkpoints
COSMOS_MEMORIES_CONTAINER=memories

# Auth: JSON mapping bearer tokens -> user IDs. NEVER commit real keys.
API_KEYS={"sk-yourkey": "your-user-id"}

# Phase 6 Content Safety API
CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
CONTENT_SAFETY_KEY=<your-key>
JWT_SECRET_KEY=<your-secret-key>
LANGCHAIN_API_KEY=<your-langchain-api-key>
LANGCHAIN_PROJECT=<your-langchain-project>
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# Phase 7 eval dataset name in LangSmith (optional; defaults to capstone-phase7).
LANGSMITH_DATASET=capstone-phase7

# Optional Phase 7 comparison path: export traces to Application Insights /
# Foundry instead of LangSmith. Only used by scripts/run_with_otel.py.
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...