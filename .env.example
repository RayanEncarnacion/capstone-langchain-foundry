# Copy to .env and fill in. NEVER commit the real .env.
# .env is git-ignored so no secret/credential is hard-coded.

# Required: Foundry v1 (OpenAI-compatible) endpoint. Copy it from the
# deployment page in Foundry. Must end with /openai/v1
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1

# Required: the deployment name you created in Foundry.
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional: API key. Leave BLANK to use Azure AD / DefaultAzureCredential
# (keyless, recommended). If set, key auth is used instead.
AZURE_OPENAI_API_KEY=
